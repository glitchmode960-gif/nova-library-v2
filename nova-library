        function T:Slider(cfg)
            cfg = cfg or {}
            local min, max = cfg.Min or 0, cfg.Max or 100
            local value = cfg.Default or min
            local row = create("Frame", {
                Size = UDim2.new(1, 0, 0, 50),
                BackgroundColor3 = COLORS.ITEM,
                BorderSizePixel = 0,
                Parent = scroll,
