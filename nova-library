local toastHolder

function Nova:Toast(text, duration)
    if not toastHolder or not toastHolder.Parent then return end
    local t = create("TextLabel", {
        Size = UDim2.new(0, 220, 0, 40),
        Position = UDim2.new(0.5, -110, 1, 100),
        BackgroundColor3 = COLORS.PANEL,
        BorderSizePixel = 0,
        Font = Enum.Font.GothamBold,
        Text = text or "Toast",
        TextColor3 = COLORS.Text,
        TextSize = 13,
        ZIndex = 20000,
        Parent = toastHolder,
    })
    corner(t, 20)
    stroke(t, THEMES[currentTheme].Accent, 2, 0.3)
    TweenService:Create(t, TweenInfo.new(0.3, Enum.EasingStyle.Back), {
        Position = UDim2.new(0.5, -110, 1, -60),
    }):Play()
    task.delay(duration or 2, function()
        TweenService:Create(t, TweenInfo.new(0.3), {
            Position = UDim2.new(0.5, -110, 1, 100),
        }):Play()
        task.wait(0.4)
        t:Destroy()
    end)
end

