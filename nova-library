                Text = cfg.Name or "Keybind",
                TextColor3 = COLORS.Text, TextSize = 13,
                TextXAlignment = Enum.TextXAlignment.Left,
                Parent = row,
            })
            local keyBadge = create("TextButton", {
                Size = UDim2.fromOffset(84, 26),
                Position = UDim2.new(1, -94, 0.5, -13),
                BackgroundColor3 = COLORS.HOVER,
                BorderSizePixel = 0,
                Font = Enum.Font.GothamBold,
                Text = key.Name, TextColor3 = COLORS.Text, TextSize = 12,
                AutoButtonColor = false,
                Parent = row,
            })
            corner(keyBadge, 8)

            local conn
            keyBadge.MouseButton1Click:Connect(function()
                if listening then return end
                listening = true
                keyBadge.Text = "..."
                conn = UserInputService.InputBegan:Connect(function(input)
                    if input.UserInputType ~= Enum.UserInputType.Keyboard then return end
                    if input.KeyCode == Enum.KeyCode.Escape then
                        keyBadge.Text = key.Name
                        listening = false
                        conn:Disconnect()
                        return
                    end
                    key = input.KeyCode
                    keyBadge.Text = key.Name
                    listening = false
                    conn:Disconnect()
                    if cfg.Callback then pcall(cfg.Callback, key) end
                end)
            end)

            UserInputService.InputBegan:Connect(function(input, gp)
                if gp then return end
                if input.KeyCode == key and cfg.Callback then pcall(cfg.Callback) end
            end)
        end

