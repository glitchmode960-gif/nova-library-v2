-- ПРОДОЛЖЕНИЕ В ЧАСТИ 5
-- ============================================================
-- CLICK FX (эффект на клик)
-- ============================================================
local clickFxEnabled = false
local clickFxStyle = "Rings"
local clickFxColor = "theme"
local clickFxSize = 80
local clickFxRings = 3
local clickFxDuration = 0.65
local clickFxConn
local clickFxGui

local STYLES = { Rings = true, Pulse = true, Burst = true, Focus = true }

local function getFxColor()
    if typeof(clickFxColor) == "Color3" then return clickFxColor end
    if clickFxColor == "rainbow" then return Color3.fromHSV((os.clock() * 0.35) % 1, 0.8, 1) end
    return THEMES[currentTheme].Accent
end

local function newFxCircle(parent, pos, size, color, z)
    local f = create("Frame", {
        AnchorPoint = Vector2.new(0.5, 0.5),
        Position = UDim2.new(0, pos.X, 0, pos.Y),
        Size = UDim2.fromOffset(size, size),
        BackgroundColor3 = color,
        BackgroundTransparency = 1,
        BorderSizePixel = 0,
        ZIndex = z or 1,
        Parent = parent,
    })
    corner(f, 999)
    return f
end

local function spawnClickFx(pos)
    if not clickFxGui then return end
    if not STYLES[clickFxStyle] then clickFxStyle = "Rings" end

    local color = getFxColor()
    local size, dur, n, style = clickFxSize, clickFxDuration, clickFxRings, clickFxStyle
    local info = TweenInfo.new(dur, Enum.EasingStyle.Quad, Enum.EasingDirection.Out)

    -- Центральная вспышка
    local dot = newFxCircle(clickFxGui, pos, 14, color, 3)
    dot.BackgroundTransparency = 0.2
    TweenService:Create(dot, TweenInfo.new(0.28, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {
        Size = UDim2.fromOffset(2, 2),
        BackgroundTransparency = 1,
    }):Play()
    task.delay(0.33, function() dot:Destroy() end)

    if style == "Rings" or style == "Focus" then
        for i = 1, n do
            local function make()
                local maxSize = size * (0.6 + 0.4 * (i / n))
                local focus = (style == "Focus")
                local c = newFxCircle(clickFxGui, pos, focus and maxSize or 10, color, 1)
                local s = create("UIStroke", {
                    Color = color,
                    Thickness = 3.5,
                    Transparency = focus and 0.4 or 0.1,
                    Parent = c,
                })
                local target = focus and 8 or maxSize
                TweenService:Create(c, info, { Size = UDim2.fromOffset(target, target) }):Play()
                TweenService:Create(s, info, { Transparency = 1, Thickness = 0.8 }):Play()
                task.delay(dur + 0.05, function() c:Destroy() end)
            end
            if i == 1 then make() else task.delay((i - 1) * 0.09, make) end
        end

    elseif style == "Pulse" then
        for i = 1, n do
            local function make()
                local maxSize = size * (0.6 + 0.4 * (i / n))
                local c = newFxCircle(clickFxGui, pos, 10, color, 1)
                c.BackgroundTransparency = 0.55
                TweenService:Create(c, info, {
                    Size = UDim2.fromOffset(maxSize, maxSize),
                    BackgroundTransparency = 1,
                }):Play()
                task.delay(dur + 0.05, function() c:Destroy() end)
            end
            if i == 1 then make() else task.delay((i - 1) * 0.09, make) end
        end

    elseif style == "Burst" then
        local count = 6 + n * 2
        for i = 1, count do
            local ang = (i / count) * math.pi * 2
            local d = newFxCircle(clickFxGui, pos, 7, color, 2)
            d.BackgroundTransparency = 0.05
            TweenService:Create(d, info, {
                Position = UDim2.new(0, pos.X + math.cos(ang) * size * 0.6, 0, pos.Y + math.sin(ang) * size * 0.6),
                Size = UDim2.fromOffset(2, 2),
                BackgroundTransparency = 1,
            }):Play()
            task.delay(dur + 0.05, function() d:Destroy() end)
        end
    end
end

function Nova:SetClickFx(enabled)
    clickFxEnabled = enabled and true or false
    if clickFxEnabled then
        if not clickFxGui then
            clickFxGui = create("ScreenGui", {
                Name = "Nova_ClickFX",
                ResetOnSpawn = false,
                IgnoreGuiInset = true,
                DisplayOrder = 100,
                Parent = container(),
            })
        end
        if not clickFxConn then
            clickFxConn = UserInputService.InputBegan:Connect(function(input, gp)
                if not clickFxEnabled or gp then return end
                local t = input.UserInputType
                if t == Enum.UserInputType.MouseButton1
                    or t == Enum.UserInputType.Touch then
                    spawnClickFx(pointerPos(input))
                end
            end)
        end
    else
        if clickFxConn then
            clickFxConn:Disconnect()
            clickFxConn = nil
        end
    end
end

function Nova:SetClickFxStyle(style)
    if STYLES[style] then clickFxStyle = style end
end

function Nova:SetClickFxColor(color)
    clickFxColor = color
end

-- ============================================================
-- ТЕМЫ
-- ============================================================
function Nova:SetTheme(name)
    if not THEMES[name] then return end
    currentTheme = name
    local theme = THEMES[name]

    for _, gui in ipairs(container():GetChildren()) do
        if gui:IsA("ScreenGui") and gui.Name:sub(1, 6) == "Nova_" then
            for _, obj in ipairs(gui:GetDescendants()) do
                if obj:IsA("UIStroke") and obj.Transparency < 0.5 then
                    TweenService:Create(obj, TweenInfo.new(0.3), { Color = theme.Accent }):Play()
                end
            end
        end
    end
end

function Nova:GetThemes()
    local l = {}
    for k, _ in pairs(THEMES) do table.insert(l, k) end
    table.sort(l)
    return l
end

-- ============================================================
-- СОХРАНЕНИЕ ПОЗИЦИИ ОКНА
-- ============================================================
function Nova:_savePos(wrapper)
    if type(writefile) ~= "function" then return end
    pcall(function()
        local p = wrapper.Position
        writefile("nova_pos.txt",
            p.X.Scale .. "," .. p.X.Offset .. "," .. p.Y.Scale .. "," .. p.Y.Offset)
    end)
end

function Nova:_loadPos(wrapper)
    if type(readfile) ~= "function" or type(isfile) ~= "function" then return end
    pcall(function()
        if isfile("nova_pos.txt") then
            local c = readfile("nova_pos.txt")
            local xS, xO, yS, yO = c:match("([^,]+),([^,]+),([^,]+),([^,]+)")
            if xS then
                wrapper.Position = UDim2.new(
                    tonumber(xS), tonumber(xO),
                    tonumber(yS), tonumber(yO))
            end
        end
    end)
end

-- ============================================================
-- ХОТКЕЙ ДЛЯ ПОКАЗА/СКРЫТИЯ ОКНА
-- ============================================================
function Nova:BindToggle(window, key)
    key = key or Enum.KeyCode.RightShift
    UserInputService.InputBegan:Connect(function(input, gp)
        if gp then return end
        if input.KeyCode == key then
            if window.Main then
                window.Main.Visible = not window.Main.Visible
            end
        end
    end)
end

